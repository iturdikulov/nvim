  "Term Template": {
      "prefix": "term",
      "body": [
          "---",
          "date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}T${CURRENT_HOUR}:${CURRENT_MINUTE}${CURRENT_TIMEZONE_OFFSET}",
          "tags:",

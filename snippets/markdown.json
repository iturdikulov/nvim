  "Insert code block": {
    "prefix": "cb",
    "body": ["```$1", "$0", "```"],
    "description": "Insert fenced code block"
  },
  "Insert Go code block": {
    "prefix": "cbg",
    "body": ["```go", "$0", "```"],
    "description": "Insert fenced C code block"
  },
  "Insert Python code block": {
    "prefix": "`p",
    "body": ["```python", "$1", "```\n", "$0"],
    "description": "Insert fenced Python code block"
  },
  "Insert SQL code block": {
    "prefix": "`s",
    "body": ["```sql", "$1", "```\n", "$0"],
    "description": "Insert fenced SQL code block"
  },
  "Insert shell code block": {
    "prefix": "cbs",
    "body": ["```sh", "$0", "```"],
    "description": "Insert fenced Shell code block"
  },
  "Insert my date block": {
    "prefix": "fr_date",
    "body": ["date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}T${CURRENT_HOUR}:${CURRENT_MINUTE}${CURRENT_TIMEZONE_OFFSET}"],
    "description": "Insert my date block"
  },
  "Insert blockquote snippet": {
    "prefix": "bqt",
    "body": [
      "\\",
      "> — <cite>$0</cite>"
    ],
    "description": "Insert blockquote snippet"
  },
  "Insert flashcard snippet": {
    "prefix": "flc",
    "body": ["<span class=\"f\"></span>"],
    "description": "Insert base flashcard snippet"
  },
  "Insert inline flashcard snippet": {
    "prefix": "inflc",
    "body": [":<wbr class=\"f\"> $0"],
    "description": "Insert inline flashcard snippet"
  },
  "Insert inverted inline flashcard snippet": {
    "prefix": "inflci",
    "body": [":<wbr class=\"f\" /> $0"],
    "description": "Insert inverted flashcard snippet"
  },
  "Mathjax Big O": {
    "prefix": "bo",
    "body": ["\\$\\mathcal{O}($0)\\$"],
    "description": "Insert mathjax Big O snippet"
  },
  "Mathjax Big O(n)": {
    "prefix": "bon",
    "body": ["\\$\\mathcal{O}(n$0)\\$"],
    "description": "Insert mathjax Big O(n) snippet"
  },
  "Mathjax Big O(n^2)": {
    "prefix": "bon2",
    "body": ["\\$\\mathcal{O}(n^2$0)\\$"],
    "description": "Insert mathjax Big (n^2) snippet"
  },
  "Mathjax Big O(log)": {
    "prefix": "bolog",
    "body": ["\\$\\mathcal{O}(log $0)\\$"],
    "description": "Insert mathjax Big O(log) snippet"
  }
}

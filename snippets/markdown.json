  "Person Template": {
      "prefix": "person",
      "body": [
          "---",
          "date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}T${CURRENT_HOUR}:${CURRENT_MINUTE}${CURRENT_TIMEZONE_OFFSET}",
          "tags:",
          "  - blog",
          "  - person",
          "---",
          "",
          "# Person: ${1:title}",
          "",
          "place_public_photo_or_2dd",
          "",
          "| Field       | Details |",
          "| ----------- | ------- |",
          "| Born        |         |",
          "| Other names |         |",
          "| Education   |         |",
          "| Occupations |         |",
          "| Known for   |         |",
          "| Awards      |         |",
          "| Website     |         |",
          "",
          "$0"
      ],
      "description": "Person Template"
  },
